    (h_nowrap : (callBulk 12 s0).ivlo.toNat + (callBulk 12 s0).nblocks ≤ 2 ^ 64) :
    Post (callBulk 12 s0) s0
      (run (((21 + 1) + (arg s0 4).toNat * (381 + 2)) + plainTail14 (arg s0 5).toNat + 1) s0) := by
  have h_nr' : (callBulk 12 s0).nr = 14 := by
    simp only [callBulk, arg, Nat.reduceMul, Nat.reduceAdd, BitVec.ofNat_eq_ofNat, h_nr]; rfl
  have h_dst : (callBulk 12 s0).dst.toNat + 16 * (callBulk 12 s0).nblocks ≤ 2 ^ 64 := h.args_dst.hb
  have h_src : (callBulk 12 s0).src.toNat = (callBulk 12 s0).dst.toNat ∨
      (callBulk 12 s0).src.toNat + 16 * (callBulk 12 s0).nblocks ≤ (callBulk 12 s0).dst.toNat ∨
      (callBulk 12 s0).dst.toNat + 16 * (callBulk 12 s0).nblocks ≤ (callBulk 12 s0).src.toNat := by
    rcases h.src_dst with ⟨he, -⟩ | hs
    · left; rw [he]
    · right; have := hs.omega_def; omega
  have h_src_legal : (callBulk 12 s0).src.toNat + 16 * (callBulk 12 s0).nblocks ≤ 2 ^ 64 := by
    rcases h.src_dst with ⟨he, hl⟩ | hs
    · rw [he]; exact hl
    · exact hs.ha
  rw [run_plus, run_plus, run_plus, run_plus]
  have hp := plain_pro14 s0 _ h h_nr rfl
  have hz := plain_cbz14 hp
  have hx : arg s0 4 = BitVec.ofNat 64 (arg s0 4).toNat := by simp
  rw [hx] at hz
  have hloop := loop_compose (arg s0 4).toNat (arg s0 4).isLt 381
    0x58#64 0x654#64 0x64c#64
    (fun s m hinv hpc hfit => plain_loop14 s0 s _ _ m hinv h_nr' hpc hfit h_nowrap h_dst h_src h_src_legal rfl)
    (fun s m x hg => plain_back14 hg) (by simp only [callBulk]; omega) _ hz
  have hr' : arg s0 5 = BitVec.ofNat 64 (arg s0 5).toNat := by simp
  generalize hrv : (arg s0 5).toNat = rv at h_r hr'
  have : rv = 0 ∨ rv = 1 ∨ rv = 2 ∨ rv = 3 ∨ rv = 4 ∨ rv = 5 ∨ rv = 6 ∨ rv = 7 ∨ rv = 8 ∨ rv = 9 ∨ rv = 10 ∨ rv = 11 := by omega
  rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
