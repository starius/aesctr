def plainTail14 : Nat → Nat
  | 0 => (((2) + 2) + 2) + 2
  | 1 => ((((2) + 2) + 2) + 2) + 33
  | 2 => ((((2) + 2) + 2) + 64) + 2
  | 3 => (((((2) + 2) + 2) + 64) + 2) + 33
