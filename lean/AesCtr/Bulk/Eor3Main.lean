/-- Steps the bulk function takes for `n` groups and `r` more blocks. -/
def eor3Steps (nr n r : Nat) : Nat :=
  if nr = 10 then ((19 + 1) + n * (273 + 2)) + eor3Tail10 r + 1 else if nr = 12 then ((21 + 1) + n * (321 + 2)) + eor3Tail12 r + 1 else ((21 + 1) + n * (369 + 2)) + eor3Tail14 r + 1

/-- The bulk function meets the contract: for any number of groups `n` and any
remainder `r < 12`, as long as the low 64 bits of the counter do not wrap. -/
theorem eor3_correct (s0 : ArmState) (h : Pre eor3Program 8 (callBulk 12 s0) s0)
    (h_r : (arg s0 5).toNat < 12)
    (h_nowrap : (callBulk 12 s0).ivlo.toNat + (callBulk 12 s0).nblocks ≤ 2 ^ 64) :
    Post (callBulk 12 s0) s0
      (run (eor3Steps (callBulk 12 s0).nr (arg s0 4).toNat (arg s0 5).toNat) s0) := by
  rcases h.nr with hnr | hnr | hnr
  all_goals
    rw [hnr]
    simp only [eor3Steps, show (10 : Nat) = 10 from rfl, show (12 : Nat) = 12 from rfl,
      show (14 : Nat) = 14 from rfl]
  · have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 10#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callBulk, arg] using hnr
    exact eor3_main10 s0 h h_nr h_r h_nowrap
  · have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 12#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callBulk, arg] using hnr
    exact eor3_main12 s0 h h_nr h_r h_nowrap
  · have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 14#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callBulk, arg] using hnr
    exact eor3_main14 s0 h h_nr h_r h_nowrap

