/-- Steps `ctrBlocks1Program` takes for each number of rounds. -/
def ctrBlocks1Steps (nr : Nat) : Nat :=
  if nr = 10 then 39 else if nr = 12 then 45 else 50

theorem ctrBlocks1_correct (s0 : ArmState) (h : Pre ctrBlocks1Program 6 (callN s0 1) s0) :
    Post (callN s0 1) s0 (run (ctrBlocks1Steps (callN s0 1).nr) s0) := by
  rcases h.nr with hnr | hnr | hnr
  · rw [hnr]
    have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 10#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callN, arg] using hnr
    exact ctrBlocks1_nr10 s0 h h_nr
  · rw [hnr]
    have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 12#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callN, arg] using hnr
    exact ctrBlocks1_nr12 s0 h h_nr
  · rw [hnr]
    have h_nr : read_mem_bytes 8 (r (StateField.GPR 31#5) s0 + 8#64) s0 = 14#64 := by
      apply BitVec.eq_of_toNat_eq; simpa [callN, arg] using hnr
    exact ctrBlocks1_nr14 s0 h h_nr

