def ctrBlocks4Steps (nr : Nat) : Nat :=
  if nr = 10 then 120 else if nr = 12 then 138 else 155

theorem ctrBlocks4_correct (s0 : ArmState) (h : Pre ctrBlocks4Program 6 (callN s0 4) s0) :
    Post (callN s0 4) s0 (run (ctrBlocks4Steps (callN s0 4).nr) s0) := by
  rcases h.nr with hnr | hnr | hnr
