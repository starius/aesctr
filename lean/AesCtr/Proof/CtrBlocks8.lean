def ctrBlocks8Steps (nr : Nat) : Nat :=
  if nr = 10 then 230 else if nr = 12 then 264 else 297

theorem ctrBlocks8_correct (s0 : ArmState) (h : Pre ctrBlocks8Program 6 (callN s0 8) s0) :
